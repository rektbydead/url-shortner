{
  "uid": "url-shortener",
  "title": "URL Shortener",
  "panels": [
    {
      "id": 4,
      "title": "Latency P50",
      "description": "Median response time.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_highr_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "showPoints": "never",
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Latency P95",
      "description": "95% of requests finish under this.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_highr_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "showPoints": "never",
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Latency P99",
      "description": "The slowest 1% of requests.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_highr_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "showPoints": "never",
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Requests / sec by Endpoint",
      "description": "Request rate per endpoint, so you can see what's actually getting hit",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(http_requests_total{handler=\"/shortner/random/{number_of_rows}\"}[1m]))", "legendFormat": "Get x random", "refId": "A" },
        { "expr": "sum(rate(http_requests_total{handler=\"/shortner/\"}[1m]))", "legendFormat": "Create", "refId": "B" },
        { "expr": "sum(rate(http_requests_total{handler=\"/shortner/{identifier}\"}[1m]))", "legendFormat": "Get one", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic", "seriesBy": "max" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "showPoints": "never",
            "lineWidth": 2
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 10,
      "title": "PG Active Connections",
      "description": "How many connections are open to each Postgres instance. Limit set to 200.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(pg_stat_activity_count{state=\"active\"}) by (job)",
        "legendFormat": "{{job}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "showPoints": "never",
            "lineWidth": 2
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 11,
      "title": "PG Cache Hit Ratio",
      "description": "What percentage of reads are served from memory instead of disk.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(pg_stat_database_blks_hit) by (job) / (sum(pg_stat_database_blks_hit) by (job) + sum(pg_stat_database_blks_read) by (job))",
        "legendFormat": "{{job}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "showPoints": "never",
            "lineWidth": 2
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    }
  ]
}
